COMPOSE_PROJECT_NAME=tsingai-lens

# Set a stable tag published with all three images by release-images.yml.
LENS_VERSION=

# Browser entrypoint exposed on the host.
LENS_HTTP_PORT=8080
LENS_HTTPS_PORT=8443
LENS_PUBLIC_URL=https://lens.example.test

# Required before first start. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Independent identity role/database; generate another 64-character hex value.
LENS_USERS_PASSWORD=

# Override only when publishing images under another registry or namespace.
LENS_BACKEND_IMAGE=jeanphilo/tsingai-lens-backend
LENS_FRONTEND_IMAGE=jeanphilo/tsingai-lens-frontend
LENS_USER_IMAGE=jeanphilo/tsingai-lens-user-service

# Change both if this subnet overlaps a network on your host.
LENS_NETWORK_SUBNET=172.30.50.0/24
LENS_PROXY_IP=172.30.50.254
