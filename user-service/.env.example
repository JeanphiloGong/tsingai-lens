# Local tutorial databases, separate from Lens and from each other.
# Start the PostgreSQL container and create both databases as described in README.md.
USER_DATABASE_URL=postgres://postgres@127.0.0.1:55447/lens_users_demo?sslmode=disable
TEST_USER_DATABASE_URL=postgres://postgres@127.0.0.1:55447/lens_users_test?sslmode=disable

# Local HTTP development only.
HTTP_ADDR=127.0.0.1:8097
BROWSER_ORIGIN=http://127.0.0.1:5196
COOKIE_SECURE=false

# V4 mTLS listener. Set certificate paths outside the repository before serving.
RPC_ADDR=127.0.0.1:50057
RPC_CERT=
RPC_KEY=
RPC_CA=

# V3 email registration and password recovery remain disabled until configured.
REGISTRATION_ENABLED=false
# Set a private value of at least 32 bytes before enabling; keep it across restarts.
CHALLENGE_SECRET=
# Plaintext SMTP is accepted only on literal loopback addresses for local capture.
SMTP_ADDR=127.0.0.1:1025
SMTP_FROM='Lens <noreply@example.test>'
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=
