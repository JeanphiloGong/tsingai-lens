# Copy to user-service.env and keep it private. Compose supplies the DSN,
# browser origin and trusted proxy IP from .env.
HTTP_ADDR=0.0.0.0:8097
RPC_ADDR=0.0.0.0:50057
COOKIE_SECURE=true
REGISTRATION_ENABLED=false
RPC_CERT=/run/identity/server.crt
RPC_KEY=/run/identity/server.key
RPC_CA=/run/identity/ca.crt

# Enable registration only after administrator setup and SMTP verification.
SMTP_ADDR=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# tls for implicit TLS (e.g. smtp.qq.com:465); starttls for SMTP upgrade.
# none is restricted to literal loopback addresses for local capture.
SMTP_TLS_MODE=starttls
CHALLENGE_SECRET=
