# This file is consumed by the backend container.
ENV_FILE=True

# compose.yml injects LENS_DATABASE_URL from POSTGRES_PASSWORD in .env.
# Do not duplicate the database URL or password in this file.

# OpenAI-compatible LLM endpoint. Local Ollama/vLLM examples usually expose /v1.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
CORE_LLM_EXTRACTION_MODE=json_text
CORE_EXTRACTION_MAX_CONCURRENCY=4
# Maximum model-tool decision cycles in one Research Agent turn.
LENS_AGENT_MAX_MODEL_STEPS=12

# OpenAI-compatible embedding endpoint.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Same-origin Docker deployment does not require browser CORS.
CORS_ALLOWED_ORIGINS=
